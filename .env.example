# IvyQuest v10.0 Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE (Required)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# OPENAI (Required for Agents)
# =============================================================================
OPENAI_API_KEY=sk-...

# =============================================================================
# GOOGLE AI (Optional - for Gemini)
# =============================================================================
GOOGLE_GENERATIVE_AI_API_KEY=

# =============================================================================
# V10.0 AGENT SERVICE
# =============================================================================
# URL of the Python agent service (FastAPI)
AGENT_SERVICE_URL=http://localhost:8000

# =============================================================================
# V10.0 FEATURE FLAGS
# Set to "true" to enable each feature
# =============================================================================

# Master switch for v10.0 agent system
ENABLE_V10_AGENTS=false

# Individual agent features
ENABLE_ASSESSMENT_AGENT=false
ENABLE_EXECUTION_AGENT=false
ENABLE_GAMEPLAN_AGENT=false
ENABLE_AWARDS_AGENT=false
ENABLE_OPPORTUNITY_AGENT=false

# Crisis Alchemy (4-step protocol via LangGraph)
ENABLE_CRISIS_ALCHEMY=false

# CRI (Context Relativity Index) computation
ENABLE_CRI_COMPUTATION=false

# EDS (Execution Debt Score) tracking
ENABLE_EDS_TRACKING=false

# Human-in-the-Loop mode for crisis responses
ENABLE_HITL_MODE=false

# Dual View (student vs parent messaging)
ENABLE_DUAL_VIEW=false

# Event Bus for agent communication
ENABLE_EVENT_BUS=false

# State versioning for audit trail
ENABLE_STATE_VERSIONING=false

# =============================================================================
# STRATEGIC OVERWHELM CONFIGURATION
# =============================================================================
# Task capacity multiplier (1.4 = assign 40% more than expected capacity)
OVERWHELM_FACTOR=1.4

# Target completion rate (0.73 = 73%)
TARGET_COMPLETION_RATE=0.73

# =============================================================================
# HITL CONFIGURATION
# =============================================================================
# Timeout for parent approval in hours (default 1 hour)
HITL_TIMEOUT_HOURS=1.0

# Auto-approve low-urgency crises after timeout
HITL_AUTO_APPROVE_LOW_URGENCY=false

# =============================================================================
# CALENDLY (Optional - for coach scheduling)
# =============================================================================
CALENDLY_API_KEY=
CALENDLY_WEBHOOK_SECRET=
