# ========================================
# IvyQuest v12.0 Environment Configuration
# ========================================

# Core Feature Flags (default: true)
NEXT_PUBLIC_ENABLE_V10_AGENTS=true
NEXT_PUBLIC_ENABLE_CRI_SCORING=true
NEXT_PUBLIC_ENABLE_COMMAND_DECK=true

# v11/v12 Feature Flags (default: true)
NEXT_PUBLIC_ENABLE_EDGE_POINTS=true    # Edge points system
NEXT_PUBLIC_ENABLE_SVG_ICONS=true       # SVG icons (replaces emoji)
NEXT_PUBLIC_ENABLE_TABBED_DASHBOARD=true # v12 tabbed interface

# Enhancement Flags
NEXT_PUBLIC_ENABLE_AI_CHAT=false
NEXT_PUBLIC_ENABLE_SUGGESTIONS=true
NEXT_PUBLIC_ENABLE_EVENT_BUS=true

# API Configuration
AGENT_SERVICE_URL=http://localhost:8001
AGENT_API_TIMEOUT=30000
V10_API_URL=http://localhost:8787

# URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3006
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/ivylevel

# Rollout Control
NEXT_PUBLIC_V12_ROLLOUT_PERCENTAGE=100
